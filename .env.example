# Copie este arquivo para .env (na raiz) e preencha. O .env nunca vai para o
# Git: é nele que ficam as credenciais deste ambiente.

# --- Banco de dados ----------------------------------------------------------
POSTGRES_USER=
# Pode conter caracteres especiais (@ : / # ...).
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Backend -----------------------------------------------------------------
# Porta do servidor da sala (HOST) -> porta dentro do container (BACKEND).
HOST_BACKEND_PORT=
BACKEND_PORT=
# Endereço(s) do frontend autorizados a chamar a API, separados por vírgula.
# Ex.: http://192.168.0.10:5173
CORS_ORIGIN=

# --- Autenticação ------------------------------------------------------------
# Chave que assina os tokens de login. Mínimo de 32 caracteres, aleatória e
# SECRETA (quem a conhece consegue se passar por qualquer usuário). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Primeiro usuário do sistema (cargo gerente), criado automaticamente na
# primeira subida, quando ainda não existe nenhum funcionário com login.
# Login: 3 a 50 letras minúsculas/números. Senha: mínimo de 8 caracteres.
ADMIN_LOGIN=
ADMIN_SENHA=

# --- Opcionais (valores padrão entre parênteses) -----------------------------
# Validade do login, em horas (8).
# JWT_EXPIRA_EM_HORAS=8
# Fuso do negócio: define o que é "hoje" para promoções, cupons e relatórios
# (America/Sao_Paulo).
# APP_TIMEZONE=America/Sao_Paulo
# Requisições por minuto, por IP (600). Use 0 para desligar. Em Docker Desktop
# (Windows/macOS) todas as máquinas da rede chegam com o mesmo IP: se a turma
# inteira for usar ao mesmo tempo, aumente.
# LIMITE_REQUISICOES_POR_MINUTO=600
# Tentativas de login erradas por login a cada 15 minutos (10). 0 desliga.
# LIMITE_TENTATIVAS_LOGIN=10
