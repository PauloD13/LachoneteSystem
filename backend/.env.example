# Copie este arquivo para .env (nesta pasta) para rodar o backend FORA do
# Docker (`npm run dev`). No Docker Compose quem vale é o .env da raiz do
# projeto — ver docker-compose.yml.

# Banco local. (Alternativa: DB_HOST, DB_PORT, DB_USER, DB_PASSWORD e DB_NAME
# separados — é o que o docker-compose usa, e aceita senha com @ : / #.)
DATABASE_URL="postgresql://lachonete:lachonete@localhost:5432/lachonete?schema=public"
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# --- Autenticação ------------------------------------------------------------
# Chave que assina os tokens de login (mínimo de 32 caracteres). Em
# desenvolvimento pode ficar comentada: o backend gera uma chave temporária a
# cada início (os logins caem quando o servidor reinicia). Em produção é
# obrigatória. Para gerar uma:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=""

# Primeiro usuário (cargo gerente), criado na subida se ainda não houver
# nenhum funcionário com login. São também as credenciais que os testes
# (`npm run test:e2e`) usam por padrão.
ADMIN_LOGIN="admin"
ADMIN_SENHA="admin12345"

# --- Opcionais ---------------------------------------------------------------
# Validade do login, em horas (padrão: 8).
# JWT_EXPIRA_EM_HORAS=8

# Fuso do negócio (padrão: America/Sao_Paulo): define o que é "hoje" para
# validade de promoções/cupons e para os períodos dos relatórios.
# APP_TIMEZONE="America/Sao_Paulo"

# Limite de requisições por minuto, por IP (padrão: 600; 0 desliga).
# Dica: deixe 0 no desenvolvimento se for rodar a suíte de testes várias vezes
# seguidas (cada execução faz ~500 requisições).
LIMITE_REQUISICOES_POR_MINUTO=0

# Tentativas de login erradas por login a cada 15 minutos (padrão: 10).
# Não desligue se for rodar os testes: um deles confere esse bloqueio.
# LIMITE_TENTATIVAS_LOGIN=10
