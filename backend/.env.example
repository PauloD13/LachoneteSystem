# Copie este arquivo para .env e ajuste os valores conforme necessário.
# Em Docker Compose, DATABASE_URL deve usar o nome do serviço do banco
# (ex.: "db"), nunca localhost/IP fixo — ver docker-compose.yml na raiz
# do projeto (quando existir).

DATABASE_URL="postgresql://lachonete:lachonete@localhost:5432/lachonete?schema=public"
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
